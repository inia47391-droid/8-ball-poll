<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 Ball Cheat"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v2.0 — Fixed + Full Feature"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="32dp"/>

        <!-- START / STOP -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:text="START"
            android:textSize="16sp"
            android:backgroundTint="#FFD700"
            android:textColor="#000000"
            android:layout_marginBottom="32dp"/>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#333355" android:layout_marginBottom="20dp"/>

        <!-- Overlay toggle -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Trajectory Overlay"
                android:textColor="#FFFFFF" android:textSize="15sp"/>
            <Switch android:id="@+id/switchOverlay"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- HUD toggle -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="HUD Panel (FPS / Stats)"
                android:textColor="#FFFFFF" android:textSize="15sp"/>
            <Switch android:id="@+id/switchHud"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Auto-Aim toggle -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Auto-Aim (Accessibility)"
                android:textColor="#FF6060" android:textSize="15sp"/>
            <Switch android:id="@+id/switchAutoAim"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Power slider -->
        <TextView android:id="@+id/tvPower"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Power: 100%"
            android:textColor="#AAAAAA" android:textSize="13sp"
            android:layout_marginTop="12dp" android:layout_marginBottom="4dp"/>

        <SeekBar android:id="@+id/seekPower"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="100" android:progress="100"
            android:layout_marginBottom="32dp"/>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#333355" android:layout_marginBottom="20dp"/>

        <!-- Accessibility hint -->
        <TextView android:id="@+id/tvAccessibility"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚙  Tap here to open Accessibility Settings\n(Enable '8Ball Cheat' service for Auto-Aim)"
            android:textColor="#5599FF"
            android:textSize="13sp"
            android:padding="12dp"
            android:background="#22334455"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
